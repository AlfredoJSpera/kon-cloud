{
	"git": {
		"commitMessage": "chore(release): v${version}",
		"tagName": "v${version}"
	},
	"npm": {
		"publish": false
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": "angular",
			"infile": "CHANGELOG.md"
		}
	},
	"hooks": {
		"after:bump": "npm version ${version} --workspaces --no-git-tag-version"
	}
}
